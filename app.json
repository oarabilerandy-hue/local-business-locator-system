{
  "expo": {
    "name": "Local Business Locator System",
    "slug": "local-business-locator-system",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "bw.localbusinesslocatorsystem",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CALL_PHONE"
      ]
    },
    "ios": {
      "bundleIdentifier": "bw.localbusinesslocatorsystem",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses your location to find nearby local businesses."
      }
    },
    "web": {
      "bundler": "metro",
      "name": "Local Business Locator System",
      "shortName": "Local Business Locator",
      "themeColor": "#147D52",
      "backgroundColor": "#F6F8F5"
    },
    "extra": {
      "projectDescription": "Local Business Locator System MVP for Botswana",
      "eas": {
        "projectId": "local-business-locator-system"
      }
    }
  }
}
